# AI Knowledge Assistant configuration. Copy to .env and adjust.
# Every value has a default in aka/settings.py; only set what you change.

# --- models (Ollama) ---------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
# Comma-separated, tried in order when the primary fails.
LLM_FALLBACK_MODELS=llama3.2:1b
# nomic-embed-text is English-centric; for mostly-Chinese documents a
# multilingual model such as bge-m3 retrieves noticeably better.
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_S=90
REQUEST_BUDGET_S=120

# --- storage -----------------------------------------------------------
DATA_DIR=./data
DB_DIR=./chroma_db
COLLECTION_NAME=personal_knowledge
# Default: SQLite at ./var/aka.db. Compose sets a Postgres URL.
# DATABASE_URL=postgresql+psycopg://aka:password@localhost:5432/aka

# --- resilience --------------------------------------------------------
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_TIMEOUT_S=30
EMBED_RETRY_ATTEMPTS=3
LEXICAL_FALLBACK_ENABLED=true
# Chaos testing: fail this share of model calls (0 = off; refused in production).
FAULT_INJECTION_RATE=0
FAULT_INJECTION_TARGETS=chat,embed

# --- human-in-the-loop thresholds (tune with eval/calibrate_policy.py) ---
MEMORY_AUTO_COMMIT_CONFIDENCE=0.80
MEMORY_REJECT_CONFIDENCE=0.35
ANSWER_MIN_GROUNDING=0.15
ANSWER_REVIEW_GROUNDING=0.40

# --- api / auth ----------------------------------------------------------
# Off = single-user laptop mode (every request is the local admin).
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string-before-deploying
# BOOTSTRAP_ADMIN_TOKEN=one-time-token-for-POST-/auth/bootstrap
EMBEDDED_WORKER=true
API_BASE_URL=http://localhost:8080
